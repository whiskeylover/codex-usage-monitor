<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);release/**;publish/**;output/**</DefaultItemExcludes>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.4.3</Version>
    <Product>codex-usage-monitor</Product>
    <Description>A minimal Windows tray monitor for Codex rate limits.</Description>
    <Copyright>Copyright (c) 2026 codex-usage-monitor contributors</Copyright>
    <AssemblyName>codex-usage-monitor</AssemblyName>
    <RootNamespace>CodexUsageMonitor</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>
</Project>
